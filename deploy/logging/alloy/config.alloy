// Grafana Alloy — ships every container's stdout/stderr to Loki (deploy/compose.yaml `alloy`).
// Uses the Docker API through the read-only socket mount (same pattern as host-monitor),
// not the logging driver, so `docker compose logs` / `task stack-logs` keep working.
//
// Labels per stream: `service` = compose service name (non-compose containers, e.g. the
// agent session containers carry only `container`), `logformat` = json | text. The log stack's
// own containers are dropped so alloy→loki→grafana chatter never enters the log lake.
// JSON pipelines run only for the services that emit JSON (the app host); the other plain-text
// emitters pass through raw — no JSONParserErr anywhere downstream. Postgres emits plain text
// too, but its severity word is mapped to a real `level` so Grafana stops showing UNK.
// `logger` (the emitting worker/consumer's short name) is promoted from the JSON body so the
// dashboard can filter by it — one app host runs several workers behind one `service` label.

discovery.docker "docker" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "docker" {
  targets = discovery.docker.docker.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "^(loki|alloy|grafana)$"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.*)"
    target_label  = "logformat"
    replacement   = "text"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "app-host"
    target_label  = "logformat"
    replacement   = "json"
  }
}

loki.process "docker" {
  stage.match {
    selector = "{logformat=\"json\"}"

    stage.json {
      expressions = { level = "level", logger = "logger" }
    }

    stage.labels {
      values = { level = "level", logger = "logger" }
    }
  }

  // Postgres plain text: "2026-11-26 06:40:51.849 UTC [52] LOG:  ..." — map the severity
  // word to a `level` label (LOG/INFO/NOTICE → info, WARNING → warn, DEBUG → debug,
  // ERROR/FATAL/PANIC → error). Continuation lines (STATEMENT/DETAIL bodies) don't match
  // and stay levelless; an empty value is simply not set as a label.
  stage.match {
    selector = "{service=\"postgres\"}"

    stage.regex {
      expression = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+ \\S+ \\[\\d+\\] (?P<pg_level>LOG|INFO|NOTICE|WARNING|ERROR|FATAL|PANIC|DEBUG[1-5]?):"
    }

    stage.template {
      source   = "level"
      template = `{{ if .pg_level }}{{ if or (eq .pg_level "LOG") (eq .pg_level "INFO") (eq .pg_level "NOTICE") }}info{{ else if eq .pg_level "WARNING" }}warn{{ else if (eq (substr .pg_level 0 5) "DEBUG") }}debug{{ else }}error{{ end }}{{ end }}`
    }

    stage.labels {
      values = { level = "level" }
    }
  }

  forward_to = [loki.write.loki.receiver]
}

loki.source.docker "docker" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker.output
  forward_to = [loki.process.docker.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
