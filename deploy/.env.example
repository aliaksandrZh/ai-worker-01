# pi-agent control plane — copy to deploy/.env and adjust.
# Every control-plane variable in one file; deploy/.env is gitignored.

# --- PostgreSQL (private network only; 127.0.0.1 published for local pgAdmin) ---
POSTGRES_DB=pi_agent
POSTGRES_USER=pi_agent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# --- storage paths ---
# STORAGE_ROOT is the compose bind source; STORAGE_HOST_ROOT must be its ABSOLUTE host path —
# the Run Worker composes it into the agent containers' mounts, resolved by the host daemon.
STORAGE_ROOT=../runtime/runs
STORAGE_HOST_ROOT=/var/lib/pi-agent/runs
# Host dir of the host-managed secret files (read-only bind into app-host). SECRETS_HOST_DIR must
# be its ABSOLUTE host path — the Run Worker mounts these files into agent containers as
# /run/secrets/<name> (profile secrets; names travel in deploy/config/system.yaml, values never
# leave this directory).
SECRETS_DIR=../secrets
SECRETS_HOST_DIR=/etc/pi-agent/secrets

# --- centralized logging: loki + alloy + grafana (config in deploy/logging/) ---
# Grafana log lake at http://localhost:3000, dashboard "Pi Agent Logs"; the only required
# secret below is the Grafana admin password (loki/alloy need none).
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# --- config snapshot loop (deploy/backup/config-snapshot-loop.sh) ---
CONFIG_SNAPSHOT_REPO_URL=
CONFIG_SNAPSHOT_INTERVAL_MINUTES=1440
BACKUP_INTERVAL_MINUTES=60
