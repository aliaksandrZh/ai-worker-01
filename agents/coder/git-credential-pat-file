#!/bin/sh
# Coder push credential helper: answers git's credential request with the token from the
# host-managed mounted file (GIT_CLONE_TOKEN_FILE — a baked path pointer). The token VALUE never
# enters a remote URL, persisted git config, or the environment. Fails closed when the file is
# absent or empty.
set -eu
cat > /dev/null # consume the credential query; this helper answers every 'get' the same way
: "${GIT_CLONE_TOKEN_FILE:?GIT_CLONE_TOKEN_FILE is not set}"
token="$(tr -d '\r' < "${GIT_CLONE_TOKEN_FILE}" | head -n1)"
[ -n "$token" ] || { echo "git-credential-pat-file: ${GIT_CLONE_TOKEN_FILE} holds no token" >&2; exit 1; }
printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
