# Komodo connection (create the key once: Komodo UI -> Config -> API Keys)
KOMODO_URL=http://localhost:9120
KOMODO_API_KEY=replace_with_api_key
KOMODO_API_SECRET=replace_with_api_secret

# optional overrides
# PI_WORKER_DEPLOYMENT=pi-worker
# PORT=3000

# pi session containers
# PI_WORKER_SERVER=Local
# PI_WORKER_IMAGE=pi-worker:latest

# host-bridge (commands pi asks the host to run)
# PI_HOST_BRIDGE_CWD=/some/host/dir
# PI_HOST_BRIDGE_TIMEOUT_MS=60000
