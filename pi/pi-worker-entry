#!/bin/sh
# pi-worker entry: optionally clone GIT_CLONE_REPO into /workspace, then exec pi.
# Token file is dotenv-format (pi/.env): comments, blank lines, GIT_CLONE_TOKEN=<pat>
set -eu
if [ -n "${GIT_CLONE_REPO:-}" ]; then
  token="$(tr -d '\r' <"${GIT_CLONE_TOKEN_FILE:?GIT_CLONE_TOKEN_FILE required}" \
    | sed -n 's/^GIT_CLONE_TOKEN=//p' | head -n1)"
  : "${token:?GIT_CLONE_TOKEN not found in ${GIT_CLONE_TOKEN_FILE}}"
  GIT_TERMINAL_PROMPT=0 git clone \
    "https://x-access-token:${token}@github.com/${GIT_CLONE_REPO}.git" /workspace
  git -C /workspace remote set-url origin "https://github.com/${GIT_CLONE_REPO}.git" # scrub token
fi
exec pi "$@"
