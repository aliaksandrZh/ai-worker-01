# Pi Coding Agent worker.
# Ollama runs on the host; this image only contains Pi and the basic tools
# required to inspect and modify a mounted workspace.

ARG PI_VERSION=1.5.2
ARG GH_MCP_VERSION=v2.2.0
ARG PI_UID=10001
ARG PI_GID=10001

# Source stage: the official GitHub MCP server image (static Go binary inside, at /server/github-mcp-server)
FROM ghcr.io/github/github-mcp-server:${GH_MCP_VERSION} AS gh-mcp

FROM node:24-bookworm-slim
ARG PI_VERSION
ARG PI_UID
ARG PI_GID

ENV HOME=/home/pi
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${PI_GID}" pi \
    && useradd --uid "${PI_UID}" --gid pi --create-home --shell /bin/bash pi \
    && mkdir -p /workspace /home/pi/.pi/agent \
    && chown -R pi:pi /workspace /home/pi

RUN npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

COPY pi-worker-entry /usr/local/bin/pi-worker-entry

# Official GitHub MCP server (static Go binary from the upstream image)
COPY --from=gh-mcp /server/github-mcp-server /usr/local/bin/github-mcp-server

USER pi

# Pi sessions and configuration live under /home/pi/.pi/agent.
# Mount this directory as a named volume to preserve sessions between runs.
# The workspace may be populated at start by pi-worker-entry from GIT_CLONE_REPO.
ENTRYPOINT ["sh", "/usr/local/bin/pi-worker-entry"]
CMD ["--mode", "rpc"]
