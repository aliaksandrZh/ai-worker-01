# GitHub repos to poll, comma-separated owner/name
GITHUB_REPOS=aliaksandrZh/04
GITHUB_POLL_INTERVAL_SEC=60
# Safety page cap per source (100 items/page)
GITHUB_PAGE_CAP=5

# auth tier: first configured wins, shown at startup.
#  1. separate-user PAT (classic scopes: repo + project + read:project)
GITHUB_USER_TOKEN=
#  2. installed GitHub App (JWT + installation tokens)
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=app.pem         (PEM file, relative to github-polling/)
GITHUB_APP_INSTALLATION_ID=         (optional; auto-discovered per repo when omitted)
#  3. gh CLI login;  4. GITHUB_TOKEN below;  5. anonymous

# optional: fallback token when the gh CLI is not installed/authenticated
# GITHUB_TOKEN=ghp_...

# write-api (github-polling/src/write-api.mjs — issues/PRs/reviews/changes; same App auth)
WRITE_API_PORT=3901
