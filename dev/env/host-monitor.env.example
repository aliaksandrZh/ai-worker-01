# host-monitor — host-specific values (attach dev/env/shared.env first in the run configuration).
ASPNETCORE_URLS=http://127.0.0.1:8083

# telemetry destination: the host-run runtime-api (RuntimeApi__ServiceToken comes from shared.env)
RuntimeApi__BaseUrl=http://127.0.0.1:8080

Storage__ManagedRoot=<absolute repo path>/runtime/storage
