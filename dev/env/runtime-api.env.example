# runtime-api — host-specific values (attach dev/env/shared.env first in the run configuration).
# Log lake note: centralized logging (loki/alloy) stays in compose; host-run services log JSON
# to stdout only, visible in the Rider run window.

# host ports: runtime-api 8080, build-worker 8081, orchestrator 8082, host-monitor 8083,
# poller 8084, outbox-worker 8085 (all bind 8080 by default — the override is mandatory)
ASPNETCORE_URLS=http://127.0.0.1:8080

# agent containers run in docker and call back to the HOST, not the compose service name
AgentContainer__CallbackBaseUrl=http://host.docker.internal:8080

# locally ManagedRoot == HostRoot (one process, no host/container path split);
# absolute repo-root paths, same for Secrets
Storage__ManagedRoot=<absolute repo path>/runtime/storage
Storage__HostRoot=<absolute repo path>/runtime/storage
Storage__SecretsManagedDir=<absolute repo path>/secrets
Storage__SecretsHostDir=<absolute repo path>/secrets
Storage__MaxLogMegabytes=50

# configuration plane (system.yaml / repositories.yaml / routing.yaml)
PI_AGENT_CONFIG_DIR=<absolute repo path>/deploy/config
