# orchestrator — host-specific values (attach dev/env/shared.env first in the run configuration).
ASPNETCORE_URLS=http://127.0.0.1:8082

# the host-run runtime-api / build-worker (tokens come from shared.env)
RuntimeApi__BaseUrl=http://127.0.0.1:8080
BuildWorker__BaseUrl=http://127.0.0.1:8081

# configuration plane + the shared Runtime Bridge implementation + the sync PAT
PI_AGENT_CONFIG_DIR=<absolute repo path>/deploy/config
PI_AGENT_RUNTIME_BRIDGE_DIR=<absolute repo path>/agents/_runtime/bridge
PI_AGENT_GITHUB_PAT_FILE=<absolute repo path>/secrets/github-sync-pat.txt

# optional traceability metadata
PI_AGENT_SOURCE_COMMIT=
