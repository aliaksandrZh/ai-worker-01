# pi-agent control plane — host-run debugging (Rider), values shared by all hosts.
# Attach this file FIRST in every .NET run configuration, then the per-host file
# (dev/env/<service>.env) so its values can override.
#
# Prereqs: full `task stack` is DOWN (its runtime-api occupies :8080); only postgres is up:
#   docker compose --env-file deploy/.env -f deploy/compose.yaml up -d postgres --wait
# (compose postgres publishes 127.0.0.1:5432 and keeps the pi-agent-net network alive
# for agent containers). Run Migrator once before the services.
#
# Flat KEY=value, no ${} substitution — compose defaults are already expanded.
# Keep POSTGRES_PASSWORD here in sync with deploy/.env.

# db (migrator, runtime-api, orchestrator, poller, outbox-worker; others ignore it)
ConnectionStrings__DefaultDb=Host=127.0.0.1;Database=pi_agent;Username=pi_agent;Password=change-me

# decision-65 dev service credentials
ServiceTokens__Orchestrator=<dev token>
ServiceTokens__HostMonitor=<dev token>
ServiceTokens__BuildWorker=<dev token>

# §13 worker tick, same as compose
WorkerLoop__IntervalSeconds=5
