# pi-agent control plane — host-run debugging (Rider): the single host is AppHost
# (EventLog + Orchestrator + Publisher + GithubSync + RunWorker consumers, gated by
# Workers:*). Attach this file FIRST in the .NET run configuration.
#
# Prereqs: `task dev-db` (postgres only, published on 127.0.0.1:5432). Keep `task stack`
# DOWN while host-running — its app-host occupies :8080. Schema is bootstrapped
# idempotently at startup (ADR-0004) — no migrator step.
#
# Flat KEY=value, no ${} substitution — compose defaults are already expanded.
# Keep POSTGRES_PASSWORD here in sync with deploy/.env.

# db
ConnectionStrings__DefaultDb=Host=127.0.0.1;Database=pi_agent;Username=pi_agent;Password=change-me

# config plane (repositories.yaml, system.yaml, routing.yaml, projects.yaml)
PI_AGENT_CONFIG_DIR=deploy/config

# the single GitHub read PAT (sync) and the single write PAT (Publisher) — ADR-0001
PI_AGENT_GITHUB_PAT_FILE=secrets/github-sync-pat.txt
PI_AGENT_GITHUB_WRITE_PAT_FILE=secrets/github-write-pat.txt
Publisher__PatFile=secrets/github-write-pat.txt

# Run Worker provisioning (docs/run-worker.md). When the app host runs ON THE HOST, the
# container-view and host-view paths are the same directories. Docker socket access and
# agent images are required — enable RunWorker only after `task build-agents`.
RunWorker__WorkspaceRoot=runtime/runs
RunWorker__WorkspaceHostRoot=
RunWorker__SecretsDir=secrets
RunWorker__SecretsHostDir=
RunWorker__CallbackBaseUrl=http://localhost:8080
RunWorker__StubBehavior=succeed
RunWorker__ImageTag=latest

# Orchestration policies (docs/flows/README.md — not flow nodes)
Orchestrator__PlanApprovalRequired=true
Orchestrator__MaxReviewRounds=3
Orchestrator__MaxRunRetries=2

# worker gates (defaults match `task dev-app`: the Run Worker stays off on the host)
Workers__Orchestrator__Enabled=true
Workers__Publisher__Enabled=true
Workers__GithubSync__Enabled=true
Workers__RunWorker__Enabled=false
