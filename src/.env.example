# pi-agent control plane — copy to src/.env and adjust.
# Every control-plane variable in one file; src/.env is gitignored.

# --- PostgreSQL (private network only, decision 65) ---
POSTGRES_DB=pi_agent
POSTGRES_USER=pi_agent
POSTGRES_PASSWORD=change-me

# --- ports / storage paths ---
# The only control-plane port published on the host (runtime-api /healthz /readyz /metrics).
RUNTIME_API_HOST_PORT=8080
# Host directory mounted read-write into host-monitor as managed storage (decision 52).
STORAGE_ROOT=./storage
# Durable Build Worker state root (ticket 10, decision 81): build-job documents, build logs and
# materialized pinned build contexts live here, so results stay retrievable across worker restarts.
BUILD_STATE_ROOT=./builds

# --- decision-65 service credentials ---
# Presented by the named client service (env ServiceAuth); accepted by runtime-api (ServiceTokens__*).
SERVICE_TOKEN_ORCHESTRATOR=orchestrator-dev-token
SERVICE_TOKEN_HOST_MONITOR=host-monitor-dev-token
SERVICE_TOKEN_BUILD_WORKER=build-worker-dev-token

# Runtime API address as the agent containers see it (bridge callback base, 04 §4).
PI_CALLBACK_BASE_URL=http://runtime-api:8080

# --- the /var/lib/pi-agent/workflows tree (decision 52) ---
# STORAGE_ROOT is the dev bind source; STORAGE_HOST_ROOT must be its ABSOLUTE host path, because that
# path is composed into the agent containers' mounts resolved by Periphery on the host.
STORAGE_ROOT=./storage
STORAGE_HOST_ROOT=/var/lib/pi-agent/workflows
# Host dir of profile secret files (decision 54); dev default matches the SECRETS_DIR bind source.
SECRETS_DIR=./secrets
PI_AGENT_SECRETS_HOST_DIR=/etc/pi-agent/secrets
# §16 max_log_size deployment copy (decision 43; keep in sync with system.yaml).
PI_AGENT_MAX_LOG_MB=50

# --- centralized logging: loki + alloy + grafana (config in src/logging/) ---
# Grafana log lake at http://localhost:3000, dashboard "Pi Agent Logs"; the only required
# secret below is the Grafana admin password (loki/alloy need none). Loki stays on the
# private network; its 127.0.0.1 port is just the LogQL/logcli endpoint for local queries.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100

# --- backups (decisions 52/76) ---
BACKUP_INTERVAL_MINUTES=60
# Optional config-plane Git snapshot; empty = snapshot loop logs-and-skips.
CONFIG_SNAPSHOT_REPO_URL=

# --- configuration plane (ticket 02) ---
# Host file holding the read-only sync PAT (decisions 50/54); the Config Loader uses it for the
# GET /user bot-identity check and repository lookups. Create it before `task stack`:
#   mkdir -p src/secrets && echo <your-pat> > src/secrets/github-sync-pat.txt
# (the file is gitignored; inside compose it lands at /etc/pi-agent/secrets/github-sync-pat.txt)
# The PAT identity (GET /user login) must equal github.bot_login in src/config/system.yaml.

# Host file holding the write PAT (task 03, decision 50): the Outbox Dispatcher publishes
# orchestration-owned comments with it. Same directory, second file:
#   echo <your-write-pat> > src/secrets/github-write-pat.txt
# Missing/empty file = outbox-worker startup failure (visible in the compose --wait gate).

# Optional: Git commit of the system repo, pinned as traceability metadata on agent profile versions.
PI_AGENT_SOURCE_COMMIT=
