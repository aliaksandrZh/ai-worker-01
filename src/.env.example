# pi-agent control plane — copy to src/.env and adjust.
# Every control-plane variable in one file; src/.env is gitignored.

# --- PostgreSQL (private network only, decision 65) ---
POSTGRES_DB=pi_agent
POSTGRES_USER=pi_agent
POSTGRES_PASSWORD=change-me

# --- ports / storage paths ---
# The only control-plane port published on the host (runtime-api /healthz /readyz /metrics).
RUNTIME_API_HOST_PORT=8080
# Host directory mounted read-write into host-monitor as managed storage (decision 52).
STORAGE_ROOT=./storage

# --- decision-65 service credentials ---
# Presented by the named client service (env ServiceAuth); accepted by runtime-api (ServiceTokens__*).
SERVICE_TOKEN_ORCHESTRATOR=orchestrator-dev-token
SERVICE_TOKEN_HOST_MONITOR=host-monitor-dev-token
SERVICE_TOKEN_BUILD_WORKER=build-worker-dev-token

# --- Komodo (runtime-api readiness probe; API keys created in Komodo UI → Config → API Keys) ---
KOMODO_URL=http://komodo-core:9120
KOMODO_API_KEY=
KOMODO_API_SECRET=

# --- backups (decisions 52/76) ---
BACKUP_INTERVAL_MINUTES=60
# Optional config-plane Git snapshot; empty = snapshot loop logs-and-skips.
CONFIG_SNAPSHOT_REPO_URL=
